{
    "name": "itw/gatecha-shopware",
    "description": "GateCHA (self-hosted ALTCHA) spam protection for Shopware 6",
    "type": "shopware-platform-plugin",
    "version": "1.0.0",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "WorksDev",
            "homepage": "https://github.com/WorksDev"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.6.0 || ~6.7.0",
        "shopware/storefront": "~6.6.0 || ~6.7.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "Itw\\Gatecha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Itw\\Gatecha\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Itw\\Gatecha\\ItwGatecha",
        "label": {
            "de-DE": "GateCHA Captcha",
            "en-GB": "GateCHA Captcha"
        },
        "description": {
            "de-DE": "Spamschutz für Shopware-Formulare mit Ihrer selbst gehosteten GateCHA-Instanz",
            "en-GB": "Spam protection for Shopware forms using your self-hosted GateCHA instance"
        },
        "manufacturerLink": {
            "de-DE": "https://github.com/WorksDev/gatecha-shopware",
            "en-GB": "https://github.com/WorksDev/gatecha-shopware"
        },
        "supportLink": {
            "de-DE": "https://github.com/WorksDev/gatecha-shopware/issues",
            "en-GB": "https://github.com/WorksDev/gatecha-shopware/issues"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
